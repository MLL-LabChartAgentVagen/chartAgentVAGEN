# Python
__pycache__/
.coverage
coverage.json
*.py[cod]
*.so
.pytest_cache/
.venv/
venv/

# Environment
.env
.env.local
.env.*.local

# Pipeline artifacts (regenerate from (declarations, seed))
out/
cache/
*.parquet
*.png

# The example images a report page ships with are tracked; the page itself is not.
!plan/reports/examples/*.png
!plan/reports/examples/*.jpg

# Both generated sites are built from a run and carry their images inside them --
# twenty megabytes of embedded JPEG that any checkout can reproduce:
#   python tools/build_report.py data/generated/live
#   python tools/build_review.py --run data/generated/live
review/
plan/reports/*.html

# OS
.DS_Store

# generated artifacts
data/generated/

# ParseBench chart split (re-fetch: parsebench/tools/dataset/download_chart_split.py)
parsebench/data/raw/
parsebench/data/pages/
# ...but hand-picked example and failure-case pages are tracked
!parsebench/data/examples/**/*.png
!parsebench/data/failure_cases/**/*.png

# ParseBench parser runs (the zip the harness produced, and what it unpacks to)
parsebench/data/runs/
